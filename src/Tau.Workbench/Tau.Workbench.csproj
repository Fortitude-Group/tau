<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- The global tool owns the package id Tau.Workbench; this library ships inside it. -->
    <PackageId>Tau.Workbench.Stages</PackageId>
    <Description>Tau Workbench stages: decision spec, frontier labelling, measure, calibrate, threshold, cascade, cost and the HTML report.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <ProjectReference Include="..\Tau.Calibration\Tau.Calibration.csproj" />
    <ProjectReference Include="..\Tau.Contract\Tau.Contract.csproj" />
    <ProjectReference Include="..\Tau.Client\Tau.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tau.Workbench.Tests" />
  </ItemGroup>
</Project>
