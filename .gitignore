# .NET
bin/
obj/
*.user
[Bb]uild/
publish/
artifacts/

# Python sidecar
.venv/
__pycache__/
*.pyc
sidecar/**/env/

# Models, datasets, caches (fetched by scripts, pinned by hash — never committed)
/models/
/data/
*.onnx
*.safetensors
*.bin
.cache/
frontier-cache/

# Frontier work files hold item text (ticket rows must never be redistributed). Only cache.jsonl,
# overrides.jsonl and label-summary.json, which hold keys and answers, are committed.
examples/*/frontier/pending/
examples/*/frontier/sheets/

# Committed test data: Python-generated fixtures and the tiny provider-spike model
!tests/**/data/
!tests/Tau.Inference.Tests/Onnx/*.onnx

# ONNX Runtime native flavours and CUDA wheels (fetched by scripts/fetch-natives.ps1 and fetch-cuda.ps1)
native/

# Local reports are committed selectively; scratch is not
scratch/
*.tmp

# Secrets — never commit
.env
*.env
secrets.json

# OS
.DS_Store
Thumbs.db

# Agent worktrees (local only)
.claude/worktrees/
